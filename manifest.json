{
  "manifest_version": 3,
  "name": "CoffeeShot",
  "version": "1.0.0",
  "description": "Click the cup to save a PNG of the visible tab to your Downloads folder.",
  "permissions": ["activeTab", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CoffeeShot: save a screenshot of this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
